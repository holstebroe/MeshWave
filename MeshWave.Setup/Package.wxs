<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
	Name="MeshWave"
	Manufacturer="MeshWave"
	Version="1.0.0"
	UpgradeCode="9BD4E35F-2F35-4C5B-B96D-CF746D6D0055"
	Language="1033"
	Scope="perMachine"
	InstallerVersion="500"
	Compressed="yes">

	<MajorUpgrade DowngradeErrorMessage="A newer version of MeshWave is already installed." />
	<MediaTemplate EmbedCab="yes" />

	<Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
	<Property Id="MW_USERNAME" Secure="yes">
	  <RegistrySearch Root="HKCU" Key="Software\MeshWave\Installer" Name="Username" Type="raw" />
	</Property>
	<Property Id="MW_BASEFOLDER" Secure="yes">
	  <RegistrySearch Root="HKCU" Key="Software\MeshWave\Installer" Name="BaseFolder" Type="raw" />
	</Property>

	<Icon Id="MeshWaveIco" SourceFile="..\MeshWave\MeshWaveIcon128.ico" />
	<Property Id="ARPPRODUCTICON" Value="MeshWaveIco" />

	<StandardDirectory Id="ProgramFiles64Folder">
	  <Directory Id="INSTALLFOLDER" Name="MeshWave" />
	</StandardDirectory>

	<StandardDirectory Id="ProgramMenuFolder">
	  <Directory Id="ProgramMenuDir" Name="MeshWave" />
	</StandardDirectory>

	<StandardDirectory Id="DesktopFolder" />

	<Feature Id="MainFeature" Title="MeshWave" Level="1">
	  <ComponentGroupRef Id="AppFiles" />
	  <ComponentRef Id="DesktopShortcutComponent" />
	  <ComponentRef Id="ProgramMenuShortcutComponent" />
	  <ComponentRef Id="InstallerDefaultsComponent" />
	</Feature>

	<UI>
	  <UIRef Id="WixUI_InstallDir" />
	  <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="MeshWaveConfigDlg" />
	</UI>

	<Fragment>
	  <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
		<Files Include="..\MeshWave\bin\$(var.Configuration)\net10.0-windows\**" />
	  </ComponentGroup>
	</Fragment>

	<Fragment>
	  <DirectoryRef Id="INSTALLFOLDER">
		<Component Id="InstallerDefaultsComponent" Guid="D6C33EC4-2B78-47C6-BD6F-899AC8C68F8B" Permanent="yes">
		  <RegistryValue Root="HKCU" Key="Software\MeshWave\Installer" Name="Username" Type="string" Value="[MW_USERNAME]" />
		  <RegistryValue Root="HKCU" Key="Software\MeshWave\Installer" Name="BaseFolder" Type="string" Value="[MW_BASEFOLDER]" KeyPath="yes" />
		</Component>

		<Component Id="DesktopShortcutComponent" Guid="885F87A5-D7C6-49DE-83CD-0E0A52E1D190">
		  <Shortcut Id="DesktopShortcut"
					Directory="DesktopFolder"
					Name="MeshWave"
					Target="[INSTALLFOLDER]MeshWave.exe"
					WorkingDirectory="INSTALLFOLDER" />
		  <RegistryValue Root="HKCU" Key="Software\MeshWave" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
		</Component>

		<Component Id="ProgramMenuShortcutComponent" Guid="0854BBD7-0F62-431D-B50B-8F0BD5A2E0F4">
		  <Shortcut Id="ProgramMenuShortcut"
					Directory="ProgramMenuDir"
					Name="MeshWave"
					Target="[INSTALLFOLDER]MeshWave.exe"
					WorkingDirectory="INSTALLFOLDER" />
		  <RemoveFolder Id="RemoveProgramMenuDir" Directory="ProgramMenuDir" On="uninstall" />
		  <RegistryValue Root="HKCU" Key="Software\MeshWave" Name="ProgramMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
		</Component>
	  </DirectoryRef>
	</Fragment>

	<Fragment>
	  <UI>
		<Dialog Id="MeshWaveConfigDlg" Width="370" Height="270" Title="[ProductName] Setup">
		  <Control Id="Title" Type="Text" X="15" Y="10" Width="340" Height="20" Transparent="yes" NoPrefix="yes" Text="Configure essential MeshWave settings" />
		  <Control Id="UserLabel" Type="Text" X="20" Y="50" Width="150" Height="15" Text="User name:" />
		  <Control Id="UserEdit" Type="Edit" X="20" Y="65" Width="320" Height="18" Property="MW_USERNAME" />
		  <Control Id="FolderLabel" Type="Text" X="20" Y="95" Width="220" Height="15" Text="Base folder for MeshWave content:" />
		  <Control Id="FolderEdit" Type="Edit" X="20" Y="110" Width="320" Height="18" Property="MW_BASEFOLDER" />
		  <Control Id="Hint" Type="Text" X="20" Y="140" Width="320" Height="40" Transparent="yes" NoPrefix="yes" Text="Existing installer values are pre-filled when available; app settings files are preserved on uninstall." />

		  <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="Back">
			<Publish Event="NewDialog" Value="InstallDirDlg">1</Publish>
		  </Control>
		  <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="Next">
			<Publish Event="NewDialog" Value="VerifyReadyDlg">1</Publish>
		  </Control>
		  <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="Cancel">
			<Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
		  </Control>
		</Dialog>
	  </UI>
	</Fragment>
  </Package>
</Wix>
