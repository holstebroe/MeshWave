<UserControl x:Class="MeshWave.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:MeshWave.Wpf.Converters"
             mc:Ignorable="d"
             Height="Auto" Width="Auto"
             Background="{StaticResource BackgroundColor}">
    <UserControl.Resources>
        <converters:PathToBitmapConverter x:Key="PathToBitmap"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <DockPanel>
            <!-- Header -->
            <TextBlock DockPanel.Dock="Top"
                       Text="⚙️ Settings"
                       Style="{StaticResource SectionHeader}"
                       FontSize="28"
                       Margin="0,0,0,16"/>

            <!-- Save + hint at bottom -->
            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button Content="💾 Save Settings"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}"
                        FontSize="16"
                        Padding="20,12"
                        HorizontalAlignment="Stretch"/>
                <TextBlock Text="Settings are saved to your AppData folder"
                           Foreground="{StaticResource TextSecondaryColor}"
                           FontStyle="Italic"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Tabbed content -->
            <TabControl>

                <!-- ══════════════════ GENERAL ══════════════════ -->
                <TabItem Header="General">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560">

                            <!-- Base Folder -->
                            <TextBlock Text="📁 Base Folder"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="All MeshWave data will be stored here (Local Music, Peer Music, etc.)"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding BaseFolder, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1"
                                        Content="Browse..."
                                        Command="{Binding BrowseBaseFolderCommand}"
                                        Style="{StaticResource PrimaryButton}"/>
                            </Grid>

                            <!-- Supported extensions -->
                            <TextBlock Text="🧩 Supported Audio Extensions"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Comma-separated list used for import and library indexing (e.g. .mp3, .flac, .wav)"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBox Text="{Binding SupportedExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="60"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ══════════════════ PROFILE ══════════════════ -->
                <TabItem Header="Profile">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560">

                            <TextBlock Text="👤 Profile"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,12"/>

                            <!-- Role selector -->
                            <TextBlock Text="Account Type" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <RadioButton Content="Fan / Listener"
                                             IsChecked="{Binding IsArtist, Converter={StaticResource InverseBoolConverter}, Mode=TwoWay}"
                                             GroupName="RoleGroup"
                                             Margin="0,0,20,0"
                                             VerticalAlignment="Center"/>
                                <RadioButton Content="Artist"
                                             IsChecked="{Binding IsArtist, Mode=TwoWay}"
                                             GroupName="RoleGroup"
                                             VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Display name -->
                            <TextBlock Text="Display Name" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                            <!-- Avatar -->
                            <TextBlock Text="Avatar Image" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding AvatarImagePath, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,10,0"/>
                                <Button Grid.Column="1"
                                        Content="Browse..."
                                        Command="{Binding BrowseAvatarCommand}"
                                        Style="{StaticResource PrimaryButton}"/>
                            </Grid>

                            <TextBlock Text="Preview" Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryColor}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Border Width="64" Height="64" CornerRadius="12" ClipToBounds="True"
                                        Background="{StaticResource BackgroundColor}" Margin="0,0,12,0">
                                    <Image Source="{Binding AvatarImagePath, Converter={StaticResource PathToBitmap}}"
                                           Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Generated icon (64px)"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               FontSize="11"
                                               Margin="0,0,0,4"/>
                                    <Border Width="40" Height="40" CornerRadius="8" ClipToBounds="True"
                                            Background="{StaticResource BackgroundColor}">
                                        <Image Source="{Binding AvatarIconPath, Converter={StaticResource PathToBitmap}}"
                                               Stretch="UniformToFill"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ══════════════════ ARTIST ══════════════════ -->
                <TabItem Header="Artist">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560">

                            <!-- Disabled notice when not artist -->
                            <Border Background="#33E67E22"
                                    CornerRadius="6"
                                    Padding="12,8"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding IsArtist, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock Text="Enable the Artist account type on the Profile tab to unlock these fields."
                                           Foreground="#E67E22"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <StackPanel IsEnabled="{Binding IsArtist}">

                                <TextBlock Text="🎸 Artist Profile"
                                           Style="{StaticResource SectionHeader}"
                                           Margin="0,0,0,12"/>

                                <!-- Bio -->
                                <TextBlock Text="Bio" Margin="0,0,0,5"/>
                                <TextBlock Text="Describe yourself and your music (max 1000 characters)"
                                           Foreground="{StaticResource TextSecondaryColor}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <TextBox Text="{Binding Bio, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="100"
                                         MaxLength="1000"
                                         Margin="0,0,0,14"/>

                                <!-- Website -->
                                <TextBlock Text="Website / Social Link" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Website, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,0,14"/>

                                <!-- Banner image -->
                                <TextBlock Text="Banner Image" Margin="0,0,0,5"/>
                                <TextBlock Text="Displayed at the top of your artist profile card seen by other users"
                                           Foreground="{StaticResource TextSecondaryColor}"
                                           FontSize="11"
                                           Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding BannerImagePath, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0,0,10,0"/>
                                    <Button Grid.Column="1"
                                            Content="Browse..."
                                            Command="{Binding BrowseBannerCommand}"
                                            Style="{StaticResource PrimaryButton}"/>
                                </Grid>

                                <!-- Banner preview -->
                                <TextBlock Text="Banner Preview" Margin="0,0,0,6" Foreground="{StaticResource TextSecondaryColor}"/>
                                <Border Height="120" CornerRadius="8" ClipToBounds="True"
                                        Background="{StaticResource SurfaceLightColor}">
                                    <Image Source="{Binding BannerImagePath, Converter={StaticResource PathToBitmap}}"
                                           Stretch="UniformToFill"/>
                                </Border>

                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ══════════════════ APPEARANCE ══════════════════ -->
                <TabItem Header="Appearance">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560">

                            <TextBlock Text="🎨 Appearance"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="Theme: Dark (Light theme coming soon)"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       Margin="0,0,0,16"/>

                            <!-- Volume -->
                            <TextBlock Text="🎵 Default Volume" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0"
                                        Minimum="0" Maximum="1"
                                        Value="{Binding Volume, Mode=TwoWay}"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Volume, StringFormat={}{0:P0}}"
                                           Foreground="{StaticResource TextSecondaryColor}"
                                           VerticalAlignment="Center"
                                           Width="50"/>
                            </Grid>

                            <!-- Audio Quality -->
                            <TextBlock Text="🎵 Preferred Audio Quality" Margin="0,0,0,6"/>
                            <ComboBox SelectedValue="{Binding PreferredAudioQuality, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Margin="0,0,0,20" Width="200" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Original"/>
                                <ComboBoxItem Content="Compressed"/>
                            </ComboBox>
                            <TextBlock Foreground="{StaticResource TextSecondaryColor}"
                                       Text="If 'Compressed' is selected but unavailable, the original version will be downloaded."
                                       Margin="0,-16,0,20" FontSize="12"/>

                            <!-- Waveform style -->
                            <TextBlock Text="Waveform Style" Margin="0,0,0,6"/>
                            <TextBlock Foreground="{StaticResource TextSecondaryColor}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Margin="0,0,0,8">
                                <Run Text="Filled"/>
                                <Run Text=" — solid bars.  "/>
                                <Run Text="Cloudy"/>
                                <Run Text=" — spaced bars with reflection.  "/>
                                <Run Text="Mirror"/>
                                <Run Text=" — symmetric vertical.  "/>
                                <Run Text="Neon"/>
                                <Run Text=" — thin glowing bars.  "/>
                                <Run Text="Smooth"/>
                                <Run Text=" — Hann-envelope curve with gradient fill."/>
                            </TextBlock>
                            <ComboBox ItemsSource="{Binding AvailableWaveformStyles}"
                                      SelectedItem="{Binding WaveformStyle, Mode=TwoWay}"
                                      Padding="8,5"
                                      MinWidth="160"
                                      HorizontalAlignment="Left"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ══════════════════ NETWORK ══════════════════ -->
                <TabItem Header="Network">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="560">

                            <TextBlock Text="🌐 Peer-to-Peer Network"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Connect to the MeshWave community to share and discover music."
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"/>

                            <CheckBox IsChecked="{Binding P2PEnabled, Mode=TwoWay}"
                                      Content="Enable P2P on startup"
                                      Margin="0,0,0,14"/>

                            <CheckBox IsChecked="{Binding P2PActAsListener, Mode=TwoWay}"
                                      Content="Act as listener (accept inbound peer connections)"
                                      Margin="0,0,0,6"/>
                            <TextBlock Text="When disabled, MeshWave runs in outbound-only mode and must reach at least one bootstrap node."
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"/>

                            <TextBlock Text="Listen Port" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding P2PPort, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="1"
                                           Text="TCP port this node listens on when listener mode is enabled."
                                           Foreground="{StaticResource TextSecondaryColor}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Max Peers" Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding P2PMaxPeers, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="1"
                                           Text="Maximum peers in routing table (1–500)."
                                           Foreground="{StaticResource TextSecondaryColor}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Bootstrap Nodes" Margin="0,0,0,4"/>
                            <TextBlock Text="One node per line in host:port format. Entry points into the network."
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Margin="0,0,0,6"/>
                            <TextBox Text="{Binding P2PBootstrapNodesText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="80"
                                     FontFamily="Consolas"
                                     FontSize="12"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Identity" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding P2PIdentityInfo}"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="⚠️ Regenerating creates a new key. Peers will see you as a new user and you will lose your history."
                                       Foreground="#E67E22"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <Button Content="🔑 Regenerate Identity"
                                    Command="{Binding RegenerateIdentityCommand}"
                                    Style="{StaticResource DangerButton}"
                                    HorizontalAlignment="Left"
                                    Padding="12,6"
                                    Margin="0,0,0,14"/>

                            <TextBlock Text="Network Diagnostics" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                            <TextBlock Text="Shows latest connection attempts, rendezvous timing, and actionable NAT guidance details."
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Refresh Diagnostics"
                                        Command="{Binding RefreshNetworkDiagnosticsCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Padding="12,6"
                                        Margin="0,0,8,0"/>
                                <Button Content="Open Detailed Diagnostics"
                                        Command="{Binding OpenDetailedDiagnosticsWindowCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        HorizontalAlignment="Left"
                                        Padding="12,6"/>
                            </StackPanel>
                            <TextBox Text="{Binding NetworkDiagnosticsText}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="160"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,16"/>

                            <TextBlock Text="Detailed Network Logging" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                            <TextBlock Text="Enables NLog for P2P operations. Useful for diagnosing connection issues."
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox IsChecked="{Binding P2PLoggingEnabled, Mode=TwoWay}"
                                          Content="Enable file logging"
                                          VerticalAlignment="Center"
                                          Margin="0,0,20,0"/>
                                <CheckBox IsChecked="{Binding P2PLoggingVerbose, Mode=TwoWay}"
                                          Content="Verbose (Debug) level"
                                          IsEnabled="{Binding P2PLoggingEnabled}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="📂 Open Logs Folder"
                                        Command="{Binding OpenLogFolderCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="12,6"
                                        Margin="0,0,8,0"/>
                                <Button Content="📋 Copy Recent Logs"
                                        Command="{Binding CopyLogsToClipboardCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Padding="12,6"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ══════════════════ STORAGE ══════════════════ -->
                <TabItem Header="Storage">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="720">

                            <TextBlock Text="💾 Storage"
                                       Style="{StaticResource SectionHeader}"
                                       Margin="0,0,0,12"/>

                            <Border Style="{StaticResource InnerViewPanel}" Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Base Folder"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               FontSize="12"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding BaseFolder}"
                                               Foreground="{StaticResource TextPrimaryColor}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,8"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Used"
                                                       Foreground="{StaticResource TextSecondaryColor}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding UsedDriveDisplay}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Free"
                                                       Foreground="{StaticResource TextSecondaryColor}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding FreeDriveDisplay}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Total"
                                                       Foreground="{StaticResource TextSecondaryColor}"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding TotalDriveDisplay}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Quota warning threshold (GB)"
                                       Margin="0,0,0,4"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding StorageQuotaWarningGb, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Grid.Column="1"
                                           Text="Progress bars are green under 70%, amber under 90%, red at 90%+ of this threshold."
                                           Foreground="{StaticResource TextSecondaryColor}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="10,0,0,0"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding StorageCategories}" Margin="0,0,0,14">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource InnerViewPanel}" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Category}" FontWeight="SemiBold"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" Foreground="{StaticResource TextSecondaryColor}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Path}"
                                                           Foreground="{StaticResource TextSecondaryColor}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,0,0,6"/>
                                                <ProgressBar Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding Percentage, Mode=OneWay}"
                                                             Height="10"
                                                             Foreground="{Binding BarBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="🔄 Refresh"
                                        Command="{Binding RefreshStorageCommand}"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="0,0,8,10"/>
                                <Button Content="🧹 Clear peer manifests"
                                        Command="{Binding ClearPeerManifestCacheCommand}"
                                        Style="{StaticResource DangerButton}"
                                        Margin="0,0,8,10"/>
                                <Button Content="🧼 Clear waveform cache"
                                        Command="{Binding ClearWaveformCacheCommand}"
                                        Style="{StaticResource DangerButton}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding StorageStatusMessage}"
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap"/>

                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </DockPanel>
    </Grid>
</UserControl>
