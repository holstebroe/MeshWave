<Window x:Class="MeshWave.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MeshWave.Wpf.Views"
        xmlns:viewModels="clr-namespace:MeshWave.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="MeshWave - Decentralized Music Sharing" 
        Height="760" Width="1240"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource BackgroundColor}"
        d:DataContext="{d:DesignInstance viewModels:ApplicationViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Left Sidebar ===== -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SidebarBgColor}">
            <DockPanel>
                <!-- App branding with icon -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="15,20,15,30">
                    <StackPanel.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Minimize to Tray" Click="BrandMenu_MinimizeToTray_Click"/>
                            <MenuItem Header="Quit" Click="BrandMenu_Quit_Click"/>
                        </ContextMenu>
                    </StackPanel.ContextMenu>
                    <Image Source="Assets/MeshWaveIcon128.png"
                           Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
                    <TextBlock Text="MeshWave"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentColor}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Navigation section -->
                <StackPanel DockPanel.Dock="Top" >
                    <Button Content="🏠  Home" 
                            Style="{StaticResource SidebarNavButton}"
                            Command="{Binding Path=HomeMenuNavCommand}" />
                    <Button Content="🎵  Now Playing" 
                            Style="{StaticResource SidebarNavButton}"
                            Click="PlaybackMenu_Click"/>
                    <Button Content="🎙  Local Music"
                            Style="{StaticResource SidebarNavButton}"
                            Click="MyMusicMenu_Click"/>
                </StackPanel>

                <!-- YOUR MESH section -->
                <StackPanel DockPanel.Dock="Top" Margin="0,20,0,0">
                    <TextBlock Text="YOUR MESH"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDimColor}"
                               Margin="22,0,0,8"/>
                    <Button Content="📚  Library"
                            Style="{StaticResource SidebarNavButton}"
                            Click="LibraryMenu_Click"/>
                    <Grid>
                        <Button Content="🌐  Browse"
                                Style="{StaticResource SidebarNavButton}"
                                Click="BrowseMenu_Click"/>
                        <Border Background="#1DB954" CornerRadius="8"
                                Padding="6,1" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Margin="0,0,15,0"
                                IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasActiveDownloads}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding ActiveDownloadCount}"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="Black"/>
                        </Border>
                    </Grid>
                    <!-- Community button with new-release badge -->
                        <Button Content="👥  Community"
                                Style="{StaticResource SidebarNavButton}"
                                Click="CommunityMenu_Click"/>
                    <Grid>
                        <Button Content="⬇️  Downloads"
                                Style="{StaticResource SidebarNavButton}"
                                Click="DownloadsMenu_Click"/>
                        <Ellipse Width="8" Height="8"
                                 Fill="#E74C3C"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,6,14,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCommunityNotification}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Grid>
                </StackPanel>

                <!-- Settings just above the P2P panel, pushed to bottom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="15,0,15,8">
                    <!-- Global Pending Downloads Sidebar Section -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasActiveDownloads}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="DOWNLOADS"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextDimColor}"
                                   Margin="7,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding ActiveDownloads}"
                                      ItemTemplate="{StaticResource SidebarDownloadItemTemplate}"/>
                    </StackPanel>

                    <Border Background="{StaticResource SurfaceLightColor}" CornerRadius="8" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6" ToolTip="{Binding P2PStatusTooltip}">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center"
                                         Fill="{Binding P2PStatusColor}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NetworkStatus}" Value="Connecting">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="PulseAnimation">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                From="1.0" To="0.3" Duration="0:0:1.0" 
                                                                AutoReverse="True" RepeatBehavior="Forever"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="PulseAnimation"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding P2PStatusText}"
                                           Foreground="{StaticResource TextSecondaryColor}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           MaxWidth="180"/>
                            </StackPanel>
                            <Button Content="Connect to Mesh"
                                    Command="{Binding ConnectP2PCommand}"
                                    Padding="0,5" FontSize="12" FontWeight="SemiBold">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                        <Setter Property="Margin" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding P2PIsConnected}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Disconnect"
                                    Command="{Binding DisconnectP2PCommand}"
                                    Padding="0,5" FontSize="12" FontWeight="SemiBold">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                        <Setter Property="Margin" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding P2PIsConnected}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Fix Connectivity Button -->
                            <Button Content="🔧 Fix Connectivity"
                                    Command="{Binding OpenNatTroubleshooterCommand}"
                                    Margin="0,5,0,0" Padding="0,5" FontSize="12" FontWeight="SemiBold">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NetworkStatus}" Value="Restricted">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Content="⚙️  Settings"
                            Style="{StaticResource SidebarNavButton}"
                            Click="SettingsMenu_Click"
                            Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Filler -->
                <Grid/>
            </DockPanel>
        </Border>

        <!-- ===== Main Content Area ===== -->
        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BackgroundColor}">
            <Grid>
                <ContentControl x:Name="MainContent" Background="{StaticResource BackgroundColor}">
                    <ContentControl.Content>
                        <Binding Path="CurrentViewModel" Converter="{StaticResource ViewModelToViewConverter}"/>
                    </ContentControl.Content>
                </ContentControl>

                <!-- Mock Mode Banner -->
                <Border Background="#D32F2F" Padding="15,4" CornerRadius="0,0,0,8"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        IsHitTestVisible="False" Opacity="0.85">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMockMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="MOCK MODE" FontWeight="Bold" Foreground="White" FontSize="12" />
                </Border>
            </Grid>
        </Border>

        <!-- ===== Persistent Bottom Player Bar ===== -->
        <Border Grid.Row="1" Grid.ColumnSpan="2"
                Background="{StaticResource PlayerBarBgColor}"
                BorderBrush="{StaticResource PlayerBarBorderColor}"
                BorderThickness="0,1,0,0">
            <views:PlayerBarView/>
        </Border>
    </Grid>
</Window>
