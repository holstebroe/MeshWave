<Window x:Class="MeshWave.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MeshWave"
        mc:Ignorable="d"
        Title="MeshWave - Decentralized Music Sharing" 
        Height="700" Width="1200"
        Background="{StaticResource BackgroundColor}">
    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top" 
                  Background="{StaticResource SurfaceColor}"
                  Foreground="{StaticResource TextPrimaryColor}">
                <MenuItem Header="Home" Click="HomeMenu_Click"/>
                <MenuItem Header="Library" Click="LibraryMenu_Click"/>
                <MenuItem Header="My Music" Click="MyMusicMenu_Click"/>
                <MenuItem Header="Playback" Click="PlaybackMenu_Click"/>
                <MenuItem Header="Settings" Click="SettingsMenu_Click"/>
            </Menu>
            <ContentControl x:Name="MainContent" Background="{StaticResource BackgroundColor}">
                <ContentControl.Content>
                    <Binding Path="CurrentViewModel" Converter="{StaticResource ViewModelToViewConverter}"/>
                </ContentControl.Content>
            </ContentControl>
        </DockPanel>
    </Grid>
</Window>
