<UserControl x:Class="MeshWave.Views.PlayerBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="90" d:DesignWidth="1200">
    <!-- Bind to ApplicationViewModel.Playback -->
    <UserControl.DataContext>
        <Binding RelativeSource="{RelativeSource AncestorType=Window}" Path="DataContext.Playback"/>
    </UserControl.DataContext>

    <Grid Margin="15,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ===== Left: Track Info ===== -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="56" Height="56" CornerRadius="4"
                    Background="{StaticResource SurfaceLightColor}"
                    ClipToBounds="True" Margin="0,0,12,0">
                <Grid>
                    <TextBlock Text="♪" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryColor}"/>
                    <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center" MaxWidth="190">
                <TextBlock Text="{Binding CurrentTrackTitle, FallbackValue='—'}"
                           FontWeight="SemiBold" FontSize="14"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding CurrentArtist, FallbackValue=''}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryColor}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== Centre: Controls + progress ===== -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="400" MaxWidth="600">
            <!-- Transport buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,6">
                <Button Style="{StaticResource PlayerIconButton}"
                        Command="{Binding PreviousTrackCommand}"
                        Margin="0,0,4,0">
                    <Path Data="M11,18V6l-8.5,6 8.5,6zm.5-6l8.5,6V6l-8.5,6z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform" Width="16" Height="16"/>
                </Button>

                <Button Command="{Binding PlayPauseToggleCommand}"
                        Margin="12,0"
                        Style="{StaticResource PlayerCircleButton}">
                    <Grid>
                        <!-- Play Icon -->
                        <Path Data="M8,5.14V19.14L19,12.14L8,5.14Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform" Width="18" Height="18"
                              Margin="2,0,0,0">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <!-- Pause Icon -->
                        <Path Data="M14,19H18V5H14M6,19H10V5H6V19Z"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Stretch="Uniform" Width="18" Height="18">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>

                <Button Style="{StaticResource PlayerIconButton}"
                        Command="{Binding NextTrackCommand}"
                        Margin="4,0,0,0">
                    <Path Data="M4,18l8.5-6L4,6v12zm9-12v12l8.5-6L13,6z"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Stretch="Uniform" Width="16" Height="16"/>
                </Button>
            </StackPanel>

            <!-- Progress row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding CurrentPosition, StringFormat=mm\\:ss}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryColor}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding Duration, Converter={StaticResource TimeSpanToSecondsConverter}}"
                        Value="{Binding CurrentPosition, Mode=TwoWay, Converter={StaticResource TimeSpanToSecondsConverter}}"
                        IsMoveToPointEnabled="True"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2"
                           Text="{Binding Duration, StringFormat=mm\\:ss}"
                           FontSize="11" Foreground="{StaticResource TextSecondaryColor}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
        </StackPanel>

        <!-- ===== Right: Mute button + Volume ===== -->
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
            <!-- Clickable speaker / mute toggle -->
            <Button Command="{Binding ToggleMuteCommand}"
                    Style="{StaticResource PlayerIconButton}"
                    FontSize="16" Padding="4" Margin="0,0,6,0">
                <Button.Content>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="🔊"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="Text" Value="🔇"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button.Content>
            </Button>
            <Slider Width="90" Minimum="0" Maximum="1"
                    Value="{Binding Volume, Mode=TwoWay}"
                    VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
