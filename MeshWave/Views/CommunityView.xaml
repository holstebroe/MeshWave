<UserControl x:Class="MeshWave.Views.CommunityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MeshWave.Converters"
             mc:Ignorable="d"
             Background="{StaticResource BackgroundColor}">
    <UserControl.Resources>
        <converters:PathToBitmapConverter x:Key="PathToBitmap"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Community Mesh"
                       FontSize="28" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryColor}"/>
            <TextBlock Text="Discover users and groups, follow artists, and manage your social connections."
                       FontSize="13"
                       Foreground="{StaticResource TextSecondaryColor}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ===== Search bar ===== -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,10,0"
                     FontSize="14"
                     Background="{StaticResource SurfaceColor}"
                     Foreground="{StaticResource TextPrimaryColor}"
                     BorderBrush="{StaticResource PrimaryColor}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Column="1"
                    Content="&#x1F50D;  Search"
                    Command="{Binding SearchCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <!-- ===== Status line ===== -->
        <TextBlock Grid.Row="2"
                   Text="{Binding SearchStatus}"
                   FontSize="12" FontStyle="Italic"
                   Foreground="{StaticResource TextSecondaryColor}"
                   Margin="0,0,0,12"/>

        <!-- ===== Tab strip + content ===== -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tab strip -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Feed"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="Feed">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTabFeed}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Discover"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="Discover">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTabDiscover}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Friends"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="Friends">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTabFriends}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Following"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="Following">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTabFollowing}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Groups"
                        Command="{Binding SetTabCommand}"
                        CommandParameter="Groups">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTabGroups}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <!-- ===== Tab content ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Feed tab -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabFeed}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <!-- Feed header row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Recent Releases"
                                       FontSize="16" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryColor}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="&#x21BB;  Refresh"
                                    Command="{Binding RefreshFeedCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- Release feed items -->
                        <ItemsControl ItemsSource="{Binding ReleaseFeed}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceColor}"
                                            CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Artist avatar -->
                                            <Border Grid.Column="0" Width="36" Height="36"
                                                    CornerRadius="18" ClipToBounds="True"
                                                    Background="{StaticResource SurfaceLightColor}"
                                                    VerticalAlignment="Top" Margin="0,2,0,0">
                                                <Image Source="{Binding ArtistAvatarIconPath, Converter={StaticResource PathToBitmap}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>

                                            <!-- Track/Album info -->
                                            <StackPanel Grid.Column="1" Margin="10,0">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryColor}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryColor}"
                                                           Margin="0,2,0,0">
                                                    <Run Text="{Binding ArtistDisplayName}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding TargetType}"/>
                                                    <Run Text=" - "/>
                                                    <Run Text="{Binding ReleasedAtDisplay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Feed actions -->
                                            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                                <Button Content="+ Library"
                                                        Command="{Binding DataContext.AddToLibraryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Margin="0,0,0,6"
                                                        Padding="8,4">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                                            <Setter Property="FontSize" Value="12"/>
                                                            <Setter Property="Margin" Value="0,0,0,6"/>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <Button Command="{Binding DataContext.ToggleLikeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Padding="8,4">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                            <Setter Property="FontSize" Value="12"/>
                                                            <Setter Property="Margin" Value="0"/>
                                                            <Setter Property="Content" Value="♡ Like"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLikedByMe}" Value="True">
                                                                    <Setter Property="Content" Value="♥ Liked"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <TextBlock Text="{Binding LikeCount, StringFormat={}{0} likes}"
                                                           FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{StaticResource TextSecondaryColor}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Feed empty state -->
                        <Border CornerRadius="8" Padding="24" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ReleaseFeed.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#x1F399;" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="No releases yet. Follow artists to see their new tracks here."
                                           FontSize="14" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSecondaryColor}"/>
                                <TextBlock Text="Connect to the mesh and refresh to populate the feed."
                                           FontSize="12" HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextDimColor}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Discover: user results -->
                    <ItemsControl ItemsSource="{Binding SearchResults}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabDiscover}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceColor}"
                                        CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36"
                                                CornerRadius="18" ClipToBounds="True"
                                                Background="{StaticResource SurfaceLightColor}">
                                            <Image Source="{Binding AvatarIconPath, Converter={StaticResource PathToBitmap}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource TextPrimaryColor}"/>
                                                <!-- Artist badge -->
                                                <Border Background="{StaticResource PrimaryColor}"
                                                        CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsArtist}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="ARTIST" FontSize="9" FontWeight="Bold"
                                                               Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryColor}">
                                                <Run Text="{Binding TrackCount}"/>
                                                <Run Text=" tracks � "/>
                                                <Run Text="{Binding FollowerCount}"/>
                                                <Run Text=" followers"/>
                                            </TextBlock>
                                            <!-- Bio snippet (artists only) -->
                                            <TextBlock Text="{Binding Bio}"
                                                       FontSize="11" FontStyle="Italic"
                                                       Foreground="{StaticResource TextDimColor}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="320"
                                                       Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsArtist}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="+ Friend"
                                                Command="{Binding DataContext.AddFriendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,6,0" Padding="8,4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Margin" Value="0,0,6,0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFriend}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="3"
                                                Content="Follow"
                                                Command="{Binding DataContext.FollowUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFollowing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Discover: group results -->
                    <ItemsControl ItemsSource="{Binding GroupResults}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabDiscover}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceColor}"
                                        CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryColor}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryColor}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryColor}"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding MemberCount}"/>
                                                <Run Text=" members"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Join"
                                                Command="{Binding DataContext.JoinGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="10,4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMember}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Discover: empty state placeholder -->
                    <Border CornerRadius="8" Padding="24" Margin="0,0,0,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Background" Value="{StaticResource SurfaceColor}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsTabDiscover}" Value="True"/>
                                            <Condition Binding="{Binding IsSearching}" Value="False"/>
                                            <Condition Binding="{Binding SearchResults.Count}" Value="0"/>
                                            <Condition Binding="{Binding GroupResults.Count}" Value="0"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#x1F310;" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Search for users or groups by name or UserId."
                                       FontSize="14" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryColor}"/>
                            <TextBlock Text="{Binding DiscoverHintText}"
                                       FontSize="12" HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextDimColor}"
                                       Margin="0,4,0,0"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       MaxWidth="520"/>
                        </StackPanel>
                    </Border>

                    <!-- Friends tab -->
                    <ItemsControl ItemsSource="{Binding Friends}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabFriends}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceColor}"
                                        CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="36" Height="36"
                                                CornerRadius="18" ClipToBounds="True"
                                                Background="{StaticResource SurfaceLightColor}">
                                            <Image Source="{Binding AvatarIconPath, Converter={StaticResource PathToBitmap}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{StaticResource TextPrimaryColor}"
                                                   VerticalAlignment="Center" Margin="10,0"/>
                                        <Button Grid.Column="2"
                                                Content="Remove"
                                                Command="{Binding DataContext.RemoveFriendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Following tab: artist cards -->
                    <ItemsControl ItemsSource="{Binding Following}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabFollowing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Artist profile card -->
                                <Border Background="{StaticResource SurfaceColor}"
                                        CornerRadius="8" Margin="0,0,0,8"
                                        ClipToBounds="True"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding DataContext.BrowseArtistCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <!-- Banner image (artists only) -->
                                        <Border Height="80" ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource SurfaceLightColor}"/>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArtist}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Source="{Binding BannerImagePath, Converter={StaticResource PathToBitmap}}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Card body -->
                                        <Grid Margin="14,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36"
                                                    CornerRadius="18" ClipToBounds="True"
                                                    Background="{StaticResource SurfaceLightColor}"
                                                    VerticalAlignment="Top">
                                                <Image Source="{Binding AvatarIconPath, Converter={StaticResource PathToBitmap}}"
                                                       Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               FontWeight="SemiBold" FontSize="14"
                                                               Foreground="{StaticResource TextPrimaryColor}"/>
                                                    <Border Background="{StaticResource PrimaryColor}"
                                                            CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsArtist}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="ARTIST" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Bio}"
                                                           FontSize="12" FontStyle="Italic"
                                                           Foreground="{StaticResource TextSecondaryColor}"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="340"
                                                           Margin="0,3,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsArtist}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryColor}"
                                                           Margin="0,3,0,0">
                                                    <Run Text="{Binding TrackCount}"/>
                                                    <Run Text=" tracks � "/>
                                                    <Run Text="{Binding FollowerCount}"/>
                                                    <Run Text=" followers"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Website}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource AccentColor}"
                                                           Margin="0,2,0,0"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsArtist}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="Unfollow"
                                                    Command="{Binding DataContext.UnfollowUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Top"
                                                    Padding="8,4">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                        <Setter Property="FontSize" Value="12"/>
                                                        <Setter Property="Margin" Value="0"/>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- My Groups tab -->
                    <ItemsControl ItemsSource="{Binding MyGroups}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTabGroups}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceColor}"
                                        CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="14"
                                                       Foreground="{StaticResource TextPrimaryColor}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryColor}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Leave"
                                                Command="{Binding DataContext.LeaveGroupCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource DangerButton}">
                                                    <Setter Property="FontSize" Value="12"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>