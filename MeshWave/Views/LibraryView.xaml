<UserControl x:Class="MeshWave.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="Auto" Width="Auto"
             Background="{StaticResource BackgroundColor}">
    <Grid Margin="20">
        <StackPanel>
            <Button Content="📁 Select Music Folder" 
                   Click="SelectFolder_Click" 
                   Style="{StaticResource PrimaryButton}"
                   FontSize="16"
                   Padding="20,12"/>
            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,20,0,12"/>
            <TextBlock Text="🎵 Tracks" Style="{StaticResource SectionHeader}"/>
            <ListBox ItemsSource="{Binding Tracks}" 
                    MouseDoubleClick="OnTrackDoubleClick"
                    MinHeight="200"/>
            <TextBlock Text="💿 Albums" Style="{StaticResource SectionHeader}"/>
            <ListBox ItemsSource="{Binding Albums}" 
                    MouseDoubleClick="OnAlbumDoubleClick"
                    MinHeight="150"/>
            <TextBlock Text="Tip: Double-click a track to play it" 
                      FontStyle="Italic" 
                      Foreground="{StaticResource TextSecondaryColor}"
                      Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
