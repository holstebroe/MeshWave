<UserControl x:Class="MeshWave.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="Auto" Width="Auto"
             Background="{StaticResource BackgroundColor}">
    <Grid Margin="20">
        <StackPanel>
            <Button Content="Import My Music" 
                    Click="ImportMyMusic_Click" 
                    Style="{StaticResource PrimaryButton}"
                    FontSize="16"
                    Padding="20,12"/>

            <Border Background="{StaticResource SurfaceColor}" CornerRadius="6" Padding="12" Margin="0,10,0,10">
                <StackPanel>
                    <TextBlock Text="Import status" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ImportStatusMessage}"/>
                    <TextBlock Text="{Binding ImportCurrentFile}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock>
                        <Run Text="Imported: "/>
                        <Run Text="{Binding ImportImportedFiles}"/>
                        <Run Text="  |  Remaining: "/>
                        <Run Text="{Binding ImportRemainingFiles}"/>
                        <Run Text="  |  Total: "/>
                        <Run Text="{Binding ImportTotalFiles}"/>
                    </TextBlock>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ImportProgressPercent, Mode=OneWay}" Height="10" Margin="0,8,0,8"/>
                    <Button Content="Cancel Import"
                            Command="{Binding CancelImportCommand}"
                            IsEnabled="{Binding CanCancelImport}"
                            Style="{StaticResource PrimaryButton}"
                            Width="130"/>
                </StackPanel>
            </Border>

            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,10,0,12"/>

            <TextBlock Text="🎤 Artists" Style="{StaticResource SectionHeader}"/>
            <ListBox ItemsSource="{Binding Artists}" MinHeight="100"/>

            <TextBlock Text="🎵 Tracks" Style="{StaticResource SectionHeader}"/>
            <ListBox ItemsSource="{Binding Tracks}" 
                    MouseDoubleClick="OnTrackDoubleClick"
                    MinHeight="200"/>
            <TextBlock Text="💿 Albums" Style="{StaticResource SectionHeader}"/>
            <ListBox ItemsSource="{Binding Albums}" 
                    MouseDoubleClick="OnAlbumDoubleClick"
                    MinHeight="150"/>
            <TextBlock Text="Tip: Double-click a track to play it" 
                      FontStyle="Italic" 
                      Foreground="{StaticResource TextSecondaryColor}"
                      Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
