<UserControl x:Class="MeshWave.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="Auto" Width="Auto"
             Background="{StaticResource BackgroundColor}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <Button Content="Import My Music" 
                    Click="ImportMyMusic_Click"
                    Visibility="{Binding CanImportMyMusic, Converter={StaticResource BoolToVisibilityConverter}}"
                    Style="{StaticResource PrimaryButton}"
                    FontSize="16"
                    Padding="20,12"/>

            <Border Background="{StaticResource SurfaceColor}" CornerRadius="6" Padding="12" Margin="0,10,0,10"
                    Visibility="{Binding CanImportMyMusic, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Import status" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ImportStatusMessage}"/>
                    <TextBlock Text="{Binding ImportCurrentFile}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock>
                        <Run Text="Imported: "/>
                        <Run Text="{Binding ImportImportedFiles}"/>
                        <Run Text="  |  Remaining: "/>
                        <Run Text="{Binding ImportRemainingFiles}"/>
                        <Run Text="  |  Total: "/>
                        <Run Text="{Binding ImportTotalFiles}"/>
                    </TextBlock>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ImportProgressPercent, Mode=OneWay}" Height="10" Margin="0,8,0,8"/>
                    <Button Content="Cancel Import"
                            Command="{Binding CancelImportCommand}"
                            IsEnabled="{Binding CanCancelImport}"
                            Style="{StaticResource PrimaryButton}"
                            Width="130"/>
                </StackPanel>
            </Border>

            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                    Margin="0,10,0,12"/>
        </StackPanel>

        <TextBlock Grid.Row="1"
                   Text="Select artist -> select album -> tracks"
                   FontStyle="Italic"
                   Foreground="{StaticResource TextSecondaryColor}"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="🎤 Artists" Style="{StaticResource SectionHeader}"/>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Artists}"
                         SelectedItem="{Binding SelectedArtist, Mode=TwoWay}"
                         DisplayMemberPath="Name"
                         VerticalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="💿 Albums" Style="{StaticResource SectionHeader}"/>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Albums}"
                         SelectedItem="{Binding SelectedAlbum, Mode=TwoWay}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Border Width="36" Height="36" CornerRadius="4" ClipToBounds="True" Background="{StaticResource SurfaceColor}" Margin="0,0,8,0">
                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding TrackCount, StringFormat={}{0} tracks}" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="🎵 Tracks" Style="{StaticResource SectionHeader}"/>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Tracks}"
                         MouseDoubleClick="OnTrackDoubleClick"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <Border Width="36" Height="36" CornerRadius="4" ClipToBounds="True" Background="{StaticResource SurfaceColor}" Margin="0,0,8,0">
                                    <Image Source="{Binding CoverPath}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"/>
                                    <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
