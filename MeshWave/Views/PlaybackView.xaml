<UserControl x:Class="MeshWave.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="Auto" Width="Auto"
             Background="{StaticResource BackgroundColor}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Track Info -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="64" Height="64"
                    CornerRadius="8"
                    Background="{StaticResource SurfaceColor}"
                    ClipToBounds="True"
                    Margin="0,0,12,0">
                <Grid>
                    <TextBlock Text="♪" FontSize="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryColor}"/>
                    <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding CurrentTrackTitle}"
                           Style="{StaticResource SectionHeader}"
                           FontSize="24" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CurrentArtist}"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondaryColor}"/>
                <TextBlock Text="{Binding TrackDescription}"
                           FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryColor}"
                           Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding CurrentTrackVersion, StringFormat=Version: v{0}}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryColor}"
                               Margin="0,0,8,0"
                               Visibility="{Binding HasMultipleVersions, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="✏"
                            Width="24"
                            Height="22"
                            Padding="0"
                            FontSize="11"
                            ToolTip="Edit metadata"
                            Click="EditCurrentTrack_Click"
                            Visibility="{Binding IsOwnedTrack, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource DiscreteIconButton}"/>
                    <Button Width="24"
                            Height="22"
                            Padding="0"
                            ToolTip="Like current track"
                            Click="LikeCurrentTrack_Click"
                            Style="{StaticResource DiscreteIconButton}">
                        <Grid>
                            <!-- Not Liked (Heart Outline) -->
                            <Path Data="M12.1,18.55L12,18.65L11.89,18.55C7.14,14.24 4,11.39 4,8.5C4,6.5 5.5,5 7.5,5C9.04,5 10.54,6 11.07,7.36H12.93C13.46,6 14.96,5 16.5,5C18.5,5 20,6.5 20,8.5C20,11.39 16.86,14.24 12.1,18.55M16.5,3C14.76,3 13.09,3.81 12,5.08C10.91,3.81 9.24,3 7.5,3C4.42,3 2,5.41 2,8.5C2,12.27 5.4,15.36 10.55,20.03L12,21.35L13.45,20.03C18.6,15.36 22,12.27 22,8.5C22,5.41 19.58,3 16.5,3Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="14" Height="14">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentTrackLikedByMe}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <!-- Liked (Heart Filled) -->
                            <Path Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"
                                  Fill="#E74C3C"
                                  Stretch="Uniform" Width="14" Height="14">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrentTrackLikedByMe}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Waveform with played-region overlay + cursor -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource SurfaceColor}"
                CornerRadius="8" Padding="10"
                Margin="0,0,0,16">
            <Grid>
                <Canvas x:Name="WaveformCanvas"
                        Height="120"
                        Background="#FF0F0F0F"
                        MouseLeftButtonDown="WaveformCanvas_MouseLeftButtonDown"
                        MouseMove="WaveformCanvas_MouseMove"
                        MouseLeave="WaveformCanvas_MouseLeave">
                    <!-- Waveform bars, markers and cursor drawn in code-behind -->
                    <!-- Played-region dim overlay (drawn over waveform, under cursor) -->
                    <Rectangle x:Name="PlayedOverlay"
                               Height="120"
                               Width="0"
                               Canvas.Left="0"
                               Canvas.Top="0"
                               Fill="#66000000"
                               IsHitTestVisible="False"/>
                    <!-- Seek-preview bright overlay: cursor → mouse position -->
                    <Rectangle x:Name="SeekPreviewOverlay"
                               Height="120"
                               Width="0"
                               Canvas.Left="0"
                               Canvas.Top="0"
                               Fill="#331DB954"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"/>
                    <!-- Playback cursor line -->
                    <Rectangle x:Name="PlaybackCursor"
                               Fill="{StaticResource AccentColor}"
                               Width="2" Height="120"
                               Canvas.Left="0"
                               IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- Comments Panel -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{StaticResource SurfaceColor}"
                CornerRadius="8" Padding="15"
                Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Comments"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,10,0"/>
                    <CheckBox Content="Current version only"
                              IsChecked="{Binding ShowOnlyCurrentVersionComments, Mode=TwoWay}"
                              Foreground="{StaticResource TextSecondaryColor}"
                              VerticalAlignment="Center"
                              Visibility="{Binding HasMultipleVersions, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="200">
                    <ItemsControl ItemsSource="{Binding Comments}"
                                  VirtualizingPanel.IsVirtualizing="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF252525"
                                        CornerRadius="4" Padding="10"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding}"
                                               Foreground="{StaticResource TextPrimaryColor}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             x:Name="CommentTextBox"
                             Background="#FF252525"
                             Foreground="{StaticResource TextPrimaryColor}"
                             BorderBrush="{StaticResource PrimaryColor}"
                             AcceptsReturn="False"
                             TextChanged="CommentTextBox_TextChanged"
                             KeyDown="CommentTextBox_KeyDown"
                             ToolTip="Type a comment. Ctrl+Enter to add."
                             Margin="0,0,10,0"/>
                    <Button Grid.Column="1"
                            Content="Add Comment"
                            Click="AddComment_Click"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Right panel: album/context track list as GridView -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                Background="{StaticResource SurfaceColor}"
                CornerRadius="8" Padding="12"
                Margin="16,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4"
                            ClipToBounds="True" Background="{StaticResource BackgroundColor}"
                            Margin="0,0,8,0">
                        <Image Source="{Binding TrackContextIconPath}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TrackContextTitle}"
                               Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center"
                               Margin="0"/>
                </Grid>

                <ListView x:Name="AlbumTrackListBox"
                          Grid.Row="1"
                          ItemsSource="{Binding AlbumTracks}"
                          SelectedItem="{Binding SelectedAlbumTrack, Mode=TwoWay}"
                          MouseDoubleClick="AlbumTrackListBox_MouseDoubleClick"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryColor}"
                                                   TextAlignment="Right"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding TrackNumberLabel}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                                            <Setter Property="Text" Value="▶"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Title" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="150">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Artist}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryColor}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Duration" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Duration, StringFormat=mm\\:ss}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryColor}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Plays" Width="46">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PlayCount}"
                                                   FontSize="12"
                                                   TextAlignment="Right"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextSecondaryColor}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
