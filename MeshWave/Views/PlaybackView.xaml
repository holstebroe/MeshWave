<UserControl x:Class="MeshWave.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="Auto" Width="Auto"
             Background="{StaticResource BackgroundColor}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Track Info -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="64"
                    Height="64"
                    CornerRadius="8"
                    Background="{StaticResource SurfaceColor}"
                    ClipToBounds="True"
                    Margin="0,0,12,0">
                <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding CurrentTrackTitle}" 
                           Style="{StaticResource SectionHeader}"
                           FontSize="24"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CurrentArtist}" 
                           FontSize="16" 
                           Foreground="{StaticResource TextSecondaryColor}"/>
                <TextBlock Text="{Binding TrackDescription}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryColor}"
                           Margin="0,6,0,0"/>
                <TextBlock Text="{Binding CurrentTrackVersion, StringFormat=Version: v{0}}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryColor}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Waveform Visualization -->
        <Border Grid.Row="1" Grid.Column="0" 
                Background="{StaticResource SurfaceColor}" 
                CornerRadius="8" 
                Padding="10"
                Margin="0,0,0,20">
            <Canvas x:Name="WaveformCanvas" 
                    Height="120" 
                    Background="#FF0F0F0F"
                    MouseLeftButtonDown="WaveformCanvas_MouseLeftButtonDown">
                <!-- Waveform will be drawn here -->
                <Rectangle x:Name="PlaybackCursor" 
                          Fill="{StaticResource AccentColor}" 
                          Width="2" 
                          Height="120"
                          Canvas.Left="0"/>
            </Canvas>
        </Border>

        <!-- Position Slider and Controls -->
        <StackPanel Grid.Row="2" Grid.Column="0">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                          Text="{Binding CurrentPosition, StringFormat=mm\\:ss}"
                          Foreground="{StaticResource TextSecondaryColor}"
                          VerticalAlignment="Center"
                          Margin="0,0,10,0"/>
                <Slider Grid.Column="1"
                        Minimum="0"
                        Maximum="{Binding Duration, Converter={StaticResource TimeSpanToSecondsConverter}}"
                        Value="{Binding CurrentPosition, Mode=TwoWay, Converter={StaticResource TimeSpanToSecondsConverter}}"
                        VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" 
                          Text="{Binding Duration, StringFormat=mm\\:ss}"
                          Foreground="{StaticResource TextSecondaryColor}"
                          VerticalAlignment="Center"
                          Margin="10,0,0,0"/>
            </Grid>

            <!-- Playback Controls -->
            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0">
                <Button Command="{Binding PlayPauseToggleCommand}" 
                        Width="54"
                        Height="44"
                        FontSize="18"
                        Margin="0,0,8,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="▶"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                    <Setter Property="Content" Value="⏸"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="⏹" 
                       Command="{Binding StopCommand}" 
                       Style="{StaticResource PrimaryButton}"
                       Width="44"
                       Height="44"
                       FontSize="18"
                       Margin="0,0,8,10"/>

                <!-- Volume Control -->
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock Text="🔊" 
                              FontSize="16"
                              VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                    <Slider Width="120" 
                           Minimum="0" 
                           Maximum="1" 
                           Value="{Binding Volume, Mode=TwoWay}"
                           VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Comments Panel -->
        <Border Grid.Row="3" Grid.Column="0" 
                Background="{StaticResource SurfaceColor}" 
                CornerRadius="8" 
                Padding="15"
                Margin="0,20,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Comments" 
                              Style="{StaticResource SectionHeader}"
                              Margin="0,0,10,0"/>
                    <CheckBox Content="Current version only"
                              IsChecked="{Binding ShowOnlyCurrentVersionComments, Mode=TwoWay}"
                              Foreground="{StaticResource TextSecondaryColor}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" 
                             VerticalScrollBarVisibility="Auto"
                             MaxHeight="200">
                    <ItemsControl ItemsSource="{Binding Comments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF252525" 
                                       CornerRadius="4" 
                                       Padding="10" 
                                       Margin="0,0,0,8">
                                    <TextBlock Text="{Binding}" 
                                              Foreground="{StaticResource TextPrimaryColor}"
                                              TextWrapping="Wrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                            x:Name="CommentTextBox"
                            Background="#FF252525"
                            Foreground="{StaticResource TextPrimaryColor}"
                            BorderBrush="{StaticResource PrimaryColor}"
                            Margin="0,0,10,0"/>
                    <Button Grid.Column="1" 
                           Content="Add Comment" 
                           Click="AddComment_Click"
                           Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="4" Grid.Column="1"
                Background="{StaticResource SurfaceColor}"
                CornerRadius="8"
                Padding="12"
                Margin="16,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4" ClipToBounds="True" Background="{StaticResource BackgroundColor}" Margin="0,0,8,0">
                        <Image Source="{Binding TrackContextIconPath}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TrackContextTitle}"
                               Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center"
                               Margin="0"/>
                </Grid>

                <ListBox x:Name="AlbumTrackListBox"
                         Grid.Row="1"
                         ItemsSource="{Binding AlbumTracks}"
                         SelectedItem="{Binding SelectedAlbumTrack, Mode=TwoWay}"
                         MouseDoubleClick="AlbumTrackListBox_MouseDoubleClick"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8" Margin="0,0,0,6" Background="#FF252525">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FF252525"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                                <Setter Property="Background" Value="#FF2A3A2A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TrackNumberLabel}"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Artist}" FontSize="11" Foreground="{StaticResource TextSecondaryColor}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Duration, StringFormat=mm\\:ss}"
                                               Foreground="{StaticResource TextSecondaryColor}"
                                               Margin="0,0,14,0"
                                               VerticalAlignment="Center"/>

                                    <Button Grid.Column="3"
                                            Content="▶"
                                            Command="{Binding DataContext.PlayAlbumTrackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Width="18"
                                            Height="18"
                                            Padding="0"
                                            Margin="0"
                                            Foreground="{StaticResource TextSecondaryColor}"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
