<UserControl x:Class="MeshWave.Views.PlaybackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="Auto" Width="Auto"
             Background="{StaticResource BackgroundColor}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Track Info -->
        <Grid Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="64" Height="64"
                    CornerRadius="8"
                    Background="{StaticResource SurfaceColor}"
                    ClipToBounds="True"
                    Margin="0,0,12,0">
                <Image Source="{Binding CoverImagePath}" Stretch="UniformToFill"/>
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding CurrentTrackTitle}"
                           Style="{StaticResource SectionHeader}"
                           FontSize="24" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CurrentArtist}"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondaryColor}"/>
                <TextBlock Text="{Binding TrackDescription}"
                           FontSize="13" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryColor}"
                           Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="{Binding CurrentTrackVersion, StringFormat=Version: v{0}}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryColor}"
                               Margin="0,0,8,0"/>
                    <Button Content="✏"
                            Width="24"
                            Height="22"
                            Padding="0"
                            FontSize="11"
                            ToolTip="Edit metadata"
                            Click="EditCurrentTrack_Click"
                            Visibility="{Binding IsOwnedTrack, Converter={StaticResource BoolToVisibilityConverter}}"
                            Style="{StaticResource DiscreteIconButton}"/>
                    <Button Width="24"
                            Height="22"
                            Padding="0"
                            FontSize="11"
                            ToolTip="Like current track"
                            Click="LikeCurrentTrack_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource DiscreteIconButton}">
                                <Setter Property="Content" Value="♡"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCurrentTrackLikedByMe}" Value="True">
                                        <Setter Property="Content" Value="❤"/>
                                        <Setter Property="Foreground" Value="#E74C3C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Waveform with played-region overlay + cursor -->
        <Border Grid.Row="1" Grid.Column="0"
                Background="{StaticResource SurfaceColor}"
                CornerRadius="8" Padding="10"
                Margin="0,0,0,16">
            <Grid>
                <Canvas x:Name="WaveformCanvas"
                        Height="120"
                        Background="#FF0F0F0F"
                        MouseLeftButtonDown="WaveformCanvas_MouseLeftButtonDown"
                        MouseMove="WaveformCanvas_MouseMove"
                        MouseLeave="WaveformCanvas_MouseLeave">
                    <!-- Waveform bars, markers and cursor drawn in code-behind -->
                    <!-- Played-region dim overlay (drawn over waveform, under cursor) -->
                    <Rectangle x:Name="PlayedOverlay"
                               Height="120"
                               Width="0"
                               Canvas.Left="0"
                               Canvas.Top="0"
                               Fill="#66000000"
                               IsHitTestVisible="False"/>
                    <!-- Seek-preview bright overlay: cursor → mouse position -->
                    <Rectangle x:Name="SeekPreviewOverlay"
                               Height="120"
                               Width="0"
                               Canvas.Left="0"
                               Canvas.Top="0"
                               Fill="#331DB954"
                               Visibility="Collapsed"
                               IsHitTestVisible="False"/>
                    <!-- Playback cursor line -->
                    <Rectangle x:Name="PlaybackCursor"
                               Fill="{StaticResource AccentColor}"
                               Width="2" Height="120"
                               Canvas.Left="0"
                               IsHitTestVisible="False"/>
                </Canvas>
            </Grid>
        </Border>

        <!-- Comments Panel -->
        <Border Grid.Row="2" Grid.Column="0"
                Background="{StaticResource SurfaceColor}"
                CornerRadius="8" Padding="15"
                Margin="0,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Comments"
                               Style="{StaticResource SectionHeader}"
                               Margin="0,0,10,0"/>
                    <CheckBox Content="Current version only"
                              IsChecked="{Binding ShowOnlyCurrentVersionComments, Mode=TwoWay}"
                              Foreground="{StaticResource TextSecondaryColor}"
                              VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="200">
                    <ItemsControl ItemsSource="{Binding Comments}"
                                  VirtualizingPanel.IsVirtualizing="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF252525"
                                        CornerRadius="4" Padding="10"
                                        Margin="0,0,0,8"
                                        HorizontalAlignment="Stretch">
                                    <TextBlock Text="{Binding}"
                                               Foreground="{StaticResource TextPrimaryColor}"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Top"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             x:Name="CommentTextBox"
                             Background="#FF252525"
                             Foreground="{StaticResource TextPrimaryColor}"
                             BorderBrush="{StaticResource PrimaryColor}"
                             AcceptsReturn="False"
                             TextChanged="CommentTextBox_TextChanged"
                             KeyDown="CommentTextBox_KeyDown"
                             ToolTip="Type a comment. Ctrl+Enter to add."
                             Margin="0,0,10,0"/>
                    <Button Grid.Column="1"
                            Content="Add Comment"
                            Click="AddComment_Click"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Right panel: album/context track list as GridView -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                Background="{StaticResource SurfaceColor}"
                CornerRadius="8" Padding="12"
                Margin="16,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4"
                            ClipToBounds="True" Background="{StaticResource BackgroundColor}"
                            Margin="0,0,8,0">
                        <Image Source="{Binding TrackContextIconPath}" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding TrackContextTitle}"
                               Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center"
                               Margin="0"/>
                </Grid>

                <ListView x:Name="AlbumTrackListBox"
                          Grid.Row="1"
                          ItemsSource="{Binding AlbumTracks}"
                          SelectedItem="{Binding SelectedAlbumTrack, Mode=TwoWay}"
                          MouseDoubleClick="AlbumTrackListBox_MouseDoubleClick"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="#" Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryColor}"
                                                   TextAlignment="Right"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding TrackNumberLabel}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                                            <Setter Property="Text" Value="▶"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Title" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold" FontSize="13"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="150">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Artist}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryColor}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Duration" Width="70">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Duration, StringFormat=mm\\:ss}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryColor}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Plays" Width="46">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PlayCount}"
                                                   FontSize="12"
                                                   TextAlignment="Right"
                                                   HorizontalAlignment="Right"
                                                   Foreground="{StaticResource TextSecondaryColor}"
                                                   VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
