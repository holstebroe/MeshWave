<UserControl x:Class="MeshWave.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:MeshWave.Converters"
             mc:Ignorable="d"
             Height="Auto" Width="Auto"
             Background="{StaticResource BackgroundColor}">
    <UserControl.Resources>
        <converters:PathToBitmapConverter x:Key="PathToBitmap"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600">
                <TextBlock Text="⚙️ Settings" 
                          Style="{StaticResource SectionHeader}"
                          FontSize="28"
                          Margin="0,0,0,20"/>

                <!-- Base Folder Section -->
                <Border Background="{StaticResource SurfaceColor}" 
                       CornerRadius="8" 
                       Padding="20"
                       Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="📁 Base Folder" 
                                  Style="{StaticResource SectionHeader}"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="All MeshWave data will be stored here (My Music, Other Music, etc.)"
                                  Foreground="{StaticResource TextSecondaryColor}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" 
                                    Text="{Binding BaseFolder, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,10,0"/>
                            <Button Grid.Column="1" 
                                   Content="Browse..." 
                                   Command="{Binding BrowseBaseFolderCommand}"
                                   Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Profile -->
                <Border Background="{StaticResource SurfaceColor}" 
                       CornerRadius="8" 
                       Padding="20"
                       Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="👤 Profile"
                                  Style="{StaticResource SectionHeader}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Display Name" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                        <TextBlock Text="Avatar Image" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding AvatarImagePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0"/>
                            <Button Grid.Column="1"
                                    Content="Browse Avatar..."
                                    Command="{Binding BrowseAvatarCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </Grid>

                        <TextBlock Text="Avatar Preview" Margin="0,10,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="64" Height="64" CornerRadius="12" ClipToBounds="True" Background="{StaticResource BackgroundColor}" Margin="0,0,12,0">
                                <Image Source="{Binding AvatarImagePath, Converter={StaticResource PathToBitmap}}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Generated Icon" Margin="0,0,0,4" Foreground="{StaticResource TextSecondaryColor}"/>
                                <Border Width="40" Height="40" CornerRadius="8" ClipToBounds="True" Background="{StaticResource BackgroundColor}">
                                    <Image Source="{Binding AvatarIconPath, Converter={StaticResource PathToBitmap}}" Stretch="UniformToFill"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Playback Settings -->
                <Border Background="{StaticResource SurfaceColor}" 
                       CornerRadius="8" 
                       Padding="20"
                       Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🎵 Playback" 
                                  Style="{StaticResource SectionHeader}"
                                  Margin="0,0,0,10"/>

                        <TextBlock Text="Default Volume"
                                  Foreground="{StaticResource TextPrimaryColor}"
                                  Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                   Minimum="0" 
                                   Maximum="1" 
                                   Value="{Binding Volume, Mode=TwoWay}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1"
                                      Text="{Binding Volume, StringFormat={}{0:P0}}"
                                      Foreground="{StaticResource TextSecondaryColor}"
                                      VerticalAlignment="Center"
                                      Width="50"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Supported File Extensions -->
                <Border Background="{StaticResource SurfaceColor}" 
                       CornerRadius="8" 
                       Padding="20"
                       Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🧩 Supported Audio Extensions" 
                                  Style="{StaticResource SectionHeader}"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="Comma-separated list used for import and library indexing (example: .mp3, .flac, .wav)"
                                  Foreground="{StaticResource TextSecondaryColor}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,10"/>
                        <TextBox Text="{Binding SupportedExtensionsText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="60"/>
                    </StackPanel>
                </Border>

                <!-- Theme / Appearance Settings -->
                <Border Background="{StaticResource SurfaceColor}" 
                       CornerRadius="8" 
                       Padding="20"
                       Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🎨 Appearance" 
                                  Style="{StaticResource SectionHeader}"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="Theme: Dark (Light theme coming soon)"
                                  Foreground="{StaticResource TextSecondaryColor}"
                                  Margin="0,0,0,16"/>

                        <TextBlock Text="Waveform Style"
                                   Foreground="{StaticResource TextPrimaryColor}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource TextSecondaryColor}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Margin="0,0,0,8">
                            <Run Text="Filled"/>
                            <Run Text=" — solid bars. "/>
                            <Run Text="Cloudy"/>
                            <Run Text=" — spaced bars with a tinted reflection. "/>
                            <Run Text="Mirror"/>
                            <Run Text=" — symmetric vertical reflection. "/>
                            <Run Text="Neon"/>
                            <Run Text=" — thin glowing bars. "/>
                            <Run Text="Smooth"/>
                            <Run Text=" — Hann-envelope curve with gradient fill."/>
                        </TextBlock>
                        <ComboBox ItemsSource="{Binding AvailableWaveformStyles}"
                                  SelectedItem="{Binding WaveformStyle, Mode=TwoWay}"
                                  Padding="8,5"
                                  MinWidth="160"
                                  HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <!-- P2P Settings -->
                <Border Background="{StaticResource SurfaceColor}" 
                       CornerRadius="8" 
                       Padding="20"
                       Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="🌐 Peer-to-Peer Network" 
                                  Style="{StaticResource SectionHeader}"
                                  Margin="0,0,0,4"/>
                        <TextBlock Text="Connect to the MeshWave community to share and discover music."
                                  Foreground="{StaticResource TextSecondaryColor}"
                                  TextWrapping="Wrap"
                                  Margin="0,0,0,12"/>

                        <!-- Enable toggle -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox IsChecked="{Binding P2PEnabled, Mode=TwoWay}"
                                      Content="Enable P2P on startup"
                                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Port -->
                        <TextBlock Text="Listen Port" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding P2PPort, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1"
                                       Text="TCP port this node listens on for incoming peer connections."
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Max peers -->
                        <TextBlock Text="Max Peers" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding P2PMaxPeers, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="1"
                                       Text="Maximum number of peers to maintain in the routing table (1–500)."
                                       Foreground="{StaticResource TextSecondaryColor}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <!-- Bootstrap nodes -->
                        <TextBlock Text="Bootstrap Nodes" Margin="0,0,0,4"/>
                        <TextBlock Text="One node per line in host:port format. These are your entry points into the network (like BitTorrent bootstrap nodes)."
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>
                        <TextBox Text="{Binding P2PBootstrapNodesText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="80"
                                 FontFamily="Consolas"
                                 FontSize="12"/>

                        <!-- Identity -->
                        <TextBlock Text="Identity" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"/>
                        <TextBlock Text="{Binding P2PIdentityInfo}"
                                   Foreground="{StaticResource TextSecondaryColor}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="⚠️ Regenerating your identity creates a new cryptographic key. Peers will see you as a completely different user and you will lose your history."
                                   Foreground="#E67E22"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>
                        <Button Content="🔑 Regenerate Identity"
                                Command="{Binding RegenerateIdentityCommand}"
                                Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Left"
                                Padding="12,6"/>
                    </StackPanel>
                </Border>

                <!-- Save Button -->
                <Button Content="💾 Save Settings" 
                       Command="{Binding SaveCommand}"
                       Style="{StaticResource PrimaryButton}"
                       FontSize="16"
                       Padding="20,12"
                       HorizontalAlignment="Stretch"/>

                <TextBlock Text="Settings are saved to your AppData folder"
                          Foreground="{StaticResource TextSecondaryColor}"
                          FontStyle="Italic"
                          HorizontalAlignment="Center"
                          Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
